<?xml version='1.0'?>
<sdf version="1.9">
  <model name='beynes'>
    <pose>0 0 0 0 0 0</pose>
      <link name="link_beynes">
        <collision name="collision_beynes">
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <uri>materials/dem/beynes.tiff</uri>
              <size>4000 4000 148.24</size>
              <!--pos>0 0 37.82</pos-->
              <sampling>1</sampling>
            </heightmap>
          </geometry>
        </collision>

        <visual name="visual_beynes">
          <geometry>
            <heightmap>
              <use_terrain_paging>false</use_terrain_paging>
              <texture>
                <diffuse>materials/textures/beynes_aerial_texture.tiff</diffuse>
                <normal>materials/textures/beynes_aerial_texture.tiff</normal>
                <size>4000 4000 148.24</size>
              </texture>
             <blend>
                <min_height>2</min_height>
                <fade_dist>5</fade_dist>
              </blend>
              <blend>
                <min_height>4</min_height>
                <fade_dist>5</fade_dist>
              </blend>
              <uri>materials/dem/beynes.tiff</uri>
              <size>4000 4000 148.24</size>
              <!--pos>0 0 37.82</pos-->
              <sampling>1</sampling>
            </heightmap>
          </geometry>
        </visual>
      </link>
      <static>true</static>
  </model>
</sdf>
