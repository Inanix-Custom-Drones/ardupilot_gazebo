<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='EyedeeQuadXL'>
  
    <!--include>
      <uri>model://gimbal_small_3d</uri>
      <name>gimbal</name>
      <pose degrees="true">0 -0.01 0.25 90 0 90</pose>
       <experimental:params>
	      	<sensor element_id="pitch_link::camera">
	      		<plugin name="GstCameraPlugin" action="modify">
	      			<udp_port>5811</udp_port>
	      		</plugin>
	      	</sensor>
	</experimental:params>
    </include-->

    <include>
      <uri>model://polaris_ranger_xp900_no_roll_cage</uri>
      <model_state name="scale">
      	<scale>0.1 0.1 0.1</scale>
      </model_state>
    </include>
    
    <!--joint name="gimbal_joint" type="revolute">
      <parent>polaris_ranger_xp900::base_link</parent>
      <child>gimbal::base_link</child>
      <axis>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
        <xyz>0 0 1</xyz>
      </axis>
    </joint-->
    
    <!-- Sensors -->
  <link name='imu_link'>
    <inertial>
      <mass>0.01</mass>
      <inertia>
        <ixx>1.66667E-07</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>1.66667E-07</iyy>
        <iyz>0</iyz>
        <izz>1.66667E-07</izz>
      </inertia>
    </inertial>
    <sensor name="imu_sensor" type="imu">
      <pose degrees="true">0 0 0 180 0 0</pose>
      <always_on>1</always_on>
      <update_rate>1000.0</update_rate>
    </sensor>
  </link>
  <joint name='imu_joint' type='revolute'>
    <child>imu_link</child>
    <parent>polaris_ranger_xp900::base_link</parent>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>0</lower>
        <upper>0</upper>
      </limit>
      <dynamics>
        <damping>0.0001</damping>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
    
    <!-- Plugins -->
  <plugin name="gz::sim::systems::JointStatePublisher"
      filename="gz-sim-joint-state-publisher-system">
  </plugin>
  <plugin name="gz::sim::systems::ApplyJointForce"
      filename="gz-sim-apply-joint-force-system">
      <joint_name>polaris_ranger_xp900::rear_left_wheel_joint</joint_name>
  </plugin>
  <plugin name="gz::sim::systems::ApplyJointForce"
      filename="gz-sim-apply-joint-force-system">
      <joint_name>polaris_ranger_xp900::rear_right_wheel_joint</joint_name>
  </plugin>
  <plugin name="gz::sim::systems::ApplyJointForce"
      filename="gz-sim-apply-joint-force-system">
      <joint_name>polaris_ranger_xp900::front_left_steer_joint</joint_name>
  </plugin>
  <plugin name="gz::sim::systems::ApplyJointForce"
      filename="gz-sim-apply-joint-force-system">
      <joint_name>polaris_ranger_xp900::front_right_steer_joint</joint_name>
  </plugin>

  <plugin name="ArduPilotPlugin"
      filename="ArduPilotPlugin">
    <!-- Port settings -->
    <fdm_addr>127.0.0.1</fdm_addr>
    <fdm_port_in>9012</fdm_port_in>
    <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
    <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
    <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

    <!-- Sensors -->
    <!-- <imuName>imu_link::imu_sensor</imuName> -->
    <imuName>imu_sensor</imuName>

    <!-- Control / channels -->

    <control channel="0">
      <jointName>polaris_ranger_xp900::rear_left_wheel_joint</jointName>
      <useForce>1</useForce>
      <multiplier>100.0</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
      <type>VELOCITY</type>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>100000.0</cmd_max>
      <cmd_min>-100000.0</cmd_min>
    </control>

    <control channel="1">
      <jointName>polaris_ranger_xp900::rear_right_wheel_joint</jointName>
      <useForce>1</useForce>
      <multiplier>100.0</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
      <type>VELOCITY</type>
      <p_gain>1000</p_gain>
      <i_gain>0</i_gain>
      <d_gain>0</d_gain>
      <i_max>1</i_max>
      <i_min>-1</i_min>
      <cmd_max>100000.0</cmd_max>
      <cmd_min>-100000.0</cmd_min>
    </control>

    <control channel="2">
      <jointName>polaris_ranger_xp900::front_left_steer_joint</jointName>
      <useForce>1</useForce>
      <multiplier>1.396263402</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
      <type>EFFORT</type>
      <p_gain>10000.0</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2000</d_gain>
      <i_max>-1</i_max>
      <i_min>0</i_min>
      <cmd_max>10000.0</cmd_max>
      <cmd_min>-10000.0</cmd_min>
    </control>

    <control channel="3">
      <jointName>polaris_ranger_xp900::front_right_steer_joint</jointName>
      <useForce>1</useForce>
      <multiplier>1.396263402</multiplier>
      <offset>-0.5</offset>
      <servo_min>1000</servo_min>
      <servo_max>2000</servo_max>
      <type>EFFORT</type>
      <p_gain>10000.0</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2000</d_gain>
      <i_max>-1</i_max>
      <i_min>0</i_min>
      <cmd_max>10000.0</cmd_max>
      <cmd_min>-10000.0</cmd_min>
    </control>
  </plugin>
  </model>
</sdf>
