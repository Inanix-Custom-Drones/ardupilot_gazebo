<?xml version='1.0'?>
<sdf version="1.9">
  <model name="dronvor2">
    <include>
      <name>dronvor2</name>
      <uri>model://dronvor</uri>
      <experimental:params>
      	<plugin element_id="ArduPilotPlugin" action="remove"/>
	
	<plugin element_id="gz::sim::systems::JointPositionController" action="remove"/>
	<plugin element_id="gz::sim::systems::JointPositionController" action="remove"/>
	
	<sensor element_id="gimbal::tilt_link::camera">
      		<plugin name="GstCameraPlugin" action="modify">
      			<udp_port>14897</udp_port>
      		</plugin>
      	</sensor>
      </experimental:params>
    </include>
	<plugin name="ArduPilotPlugin"
	      filename="ArduPilotPlugin">
	      <!-- Port settings -->
	      <fdm_addr>127.0.0.1</fdm_addr>
	      <fdm_port_in>9022</fdm_port_in>
	      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
	      <lock_step>1</lock_step>

	      <!-- Frame conventions
		Require by ArduPilot: change model and gazebo from XYZ to XY-Z coordinates
	      -->
	      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
	      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>

	      <!-- Sensors -->
	      <imuName>dronvor2::iris_with_standoffs::imu_link::imu_sensor</imuName>

	      <!--
		  incoming control command [0, 1]
		  so offset it by 0 to get [0, 1]
		  and divide max target by 1.
		  offset = 0
		  multiplier = 838 max rpm / 1 = 838
		-->
	      <control channel="0">
		<jointName>dronvor2::iris_with_standoffs::rotor_0_joint</jointName>
		<useForce>1</useForce>
		<multiplier>838</multiplier>
		<offset>0</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>VELOCITY</type>
		<p_gain>0.20</p_gain>
		<i_gain>0</i_gain>
		<d_gain>0</d_gain>
		<i_max>0</i_max>
		<i_min>0</i_min>
		<cmd_max>2.5</cmd_max>
		<cmd_min>-2.5</cmd_min>
		<controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
	      </control>

	      <control channel="1">
		<jointName>dronvor2::iris_with_standoffs::rotor_1_joint</jointName>
		<useForce>1</useForce>
		<multiplier>838</multiplier>
		<offset>0</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>VELOCITY</type>
		<p_gain>0.20</p_gain>
		<i_gain>0</i_gain>
		<d_gain>0</d_gain>
		<i_max>0</i_max>
		<i_min>0</i_min>
		<cmd_max>2.5</cmd_max>
		<cmd_min>-2.5</cmd_min>
		<controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
	      </control>

	      <control channel="2">
		<jointName>dronvor2::iris_with_standoffs::rotor_2_joint</jointName>
		<useForce>1</useForce>
		<multiplier>-838</multiplier>
		<offset>0</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>VELOCITY</type>
		<p_gain>0.20</p_gain>
		<i_gain>0</i_gain>
		<d_gain>0</d_gain>
		<i_max>0</i_max>
		<i_min>0</i_min>
		<cmd_max>2.5</cmd_max>
		<cmd_min>-2.5</cmd_min>
		<controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
	      </control>

	      <control channel="3">
		<jointName>dronvor2::iris_with_standoffs::rotor_3_joint</jointName>
		<useForce>1</useForce>
		<multiplier>-838</multiplier>
		<offset>0</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>VELOCITY</type>
		<p_gain>0.20</p_gain>
		<i_gain>0</i_gain>
		<d_gain>0</d_gain>
		<i_max>0</i_max>
		<i_min>0</i_min>
		<cmd_max>2.5</cmd_max>
		<cmd_min>-2.5</cmd_min>
		<controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
	      </control>

	      <control channel="4">
		<jointName>dronvor2::gimbal::roll_joint</jointName>
		<multiplier>3.14159265</multiplier>
		<offset>-0.5</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>COMMAND</type>
		<cmd_topic>/dronvor2/gimbal/cmd_roll</cmd_topic>
		<p_gain>3</p_gain>
	      </control>

	      <control channel="5">
		<jointName>dronvor2::gimbal::tilt_joint</jointName>
		<multiplier>3.14159265</multiplier>
		<offset>-0.5</offset>
		<servo_min>1100</servo_min>
		<servo_max>1900</servo_max>
		<type>COMMAND</type>
		<cmd_topic>/dronvor2/gimbal/cmd_tilt</cmd_topic>
		<p_gain>3</p_gain>
	      </control>

	    </plugin>
    
	<plugin
		filename="gz-sim-joint-position-controller-system"
		name="gz::sim::systems::JointPositionController">
		<joint_name>dronvor2::gimbal::roll_joint</joint_name>
		<topic>/dronvor2/gimbal/cmd_roll</topic>
		<p_gain>3</p_gain>
	</plugin>
	<plugin
		filename="gz-sim-joint-position-controller-system"
		name="gz::sim::systems::JointPositionController">
		<joint_name>dronvor2::gimbal::tilt_joint</joint_name>
		<topic>/dronvor2/gimbal/cmd_tilt</topic>
		<p_gain>3</p_gain>
	</plugin>
  </model>
</sdf>
